      </div>
    </div>
  </section>

  <!-- Interactive Site Map -->
  <section id="sitemap" class="section">
    <div class="reveal">
      <p class="section-label">14</p>
      <h2 class="section-title">{t.siteMap.title}</h2>
      <p class="about-text" style="white-space:pre-line;margin-bottom:1rem;" set:html={renderText(t.siteMap.intro)}></p>
      <div class="sitemap-hint">{t.siteMap.hint}</div>
    </div>
    <div class="reveal">
      <div class="sitemap-wrap">
        <div class="sitemap-map" id="sitemap-map">
          <svg class="sitemap-svg" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <linearGradient id="hillGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#d9a86a" />
                <stop offset="100%" stop-color="#b56532" />
              </linearGradient>
            </defs>
            <path d="M0,300 L0,210 C60,180 90,150 150,160 C200,168 230,120 300,130 C350,137 380,110 400,120 L400,300 Z" fill="url(#hillGrad)" opacity="0.85" />
            <path d="M0,300 L0,240 C80,225 120,205 180,212 C250,220 300,200 400,210 L400,300 Z" fill="#a8531f" opacity="0.5" />
            <path d="M40,260 C120,235 200,250 280,225 C320,213 360,225 390,215" stroke="#faf7f2" stroke-width="2" fill="none" opacity="0.5" stroke-dasharray="4 6" />
            <path d="M70,150 C140,170 220,150 300,135" stroke="#faf7f2" stroke-width="1.5" fill="none" opacity="0.35" stroke-dasharray="3 7" />
          </svg>
          {
            t.siteMap.zones.map((z, i) => (
              <button class="sitemap-marker" type="button" data-zone={z.key}
                data-name={z.name} data-desc={z.desc}
                style={"top:${MARKER_POS[z.key].top};left:${MARKER_POS[z.key].left};"}>
                {i + 1}
              </button>
            ))
          }
        </div>
        <div class="sitemap-detail" id="sitemap-detail">
          <div class="sitemap-detail-index" id="sitemap-detail-index">01</div>
          <h3 class="sitemap-detail-name" id="sitemap-detail-name"></h3>
          <p class="sitemap-detail-desc" id="sitemap-detail-desc"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Itinerary -->
  <section id="itinerary" class="section" style="background:rgba(0,0,0,0.02);">
    <div class="reveal">
      <p class="section-label">15</p>
      <h2 class="section-title">{t.itinerary.title}</h2>
      <p class="about-text" style="white-space:pre-line;margin-bottom:3rem;" set:html={renderText(t.itinerary.intro)}></p>
    </div>
    <div class="reveal">
      <div class="timeline">
        {
          t.itinerary.steps.map((s) => (
            <div class="timeline-item">
              <div class="timeline-time">{s.time}</div>
              <div class="timeline-marker"><span class="timeline-dot"></span></div>
              <div class="timeline-card">
                <h4 class="timeline-title">{s.title}</h4>
                <p class="timeline-text">{s.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- In-depth knowledge base -->
  <section id="deep-dive" class="section">
    <div class="reveal">
      <p class="section-label">16</p>
      <h2 class="section-title">{guide.deepDive.title}</h2>
      <div class="section-divider"></div>
      <p class="about-text" set:html={renderText(guide.deepDive.intro)}></p>
    </div>
    <div class="deep-blocks">
      {
        guide.deepDive.blocks.map((block) => (
          <article class="reveal deep-block">
            <h3 class="deep-title">
              <span class="deep-icon" aria-hidden="true">
                {block.icon}
              </span>
              {block.title}
            </h3>
            {block.paragraphs.map((p) => (
              <p class="deep-text" set:html={renderText(p)} />
            ))}
            {block.facts && (
              <dl class="deep-facts">
                {block.facts.map((f) => (
                  <div class="deep-fact">
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- Sources & Official Links (E-E-A-T) -->
  <section id="sources" class="section" style="background:rgba(0,0,0,0.02);">
    <div class="reveal">
      <p class="section-label">17</p>
      <h2 class="section-title">{ec.sourcesTitle}</h2>
      <div class="section-divider"></div>
      <p class="about-text" set:html={renderText(ec.sourcesIntro)}></p>
    </div>
    <div class="reveal">
      <div class="sources-grid">
        {
          AUTHORITY_SOURCES.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="source-card">
              <h3 class="source-name">{s.name}</h3>
              <p class="source-desc">{s.desc[locale]}</p>
              <span class="source-url">{s.url}</span>
            </a>
          ))
        }
      </div>
      <p class="sources-official" set:html={renderText(
        `${ec.officialLabel}: <a href="${ATTRACTION.govtTourismUrl}" target="_blank" rel="noopener noreferrer">${ATTRACTION.govtTourismUrl}</a>`
      )}></p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-links">
      <p class="footer-links-title">{t.footer.linksTitle}</p>
      <div class="footer-links-grid">
        {
          t.footer.links.map((link: any) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="footer-link-item">
              {link.name}
            </a>
          ))
        }
      </div>
      <div style="margin-top:1.25rem;text-align:center;">
        <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="google-maps-btn">Google Maps →</a>
      </div>
    </div>
    <div class="footer-nap">
      <h3 class="footer-nap-title">{ec.napTitle}</h3>
      <p>{ec.napName}</p>
      <p>{ec.napAddress}</p>
      <p>{ec.napPhone}</p>
      <p>{ec.napHours}</p>
    </div>
    <div class="footer-legal" style="max-width:1100px;margin:0 auto;padding:1rem 2rem 0;text-align:center;">
      <a href="/privacy" style="color:rgba(255,255,255,0.5);text-decoration:none;font-size:0.8rem;margin-right:1.5rem;">Privacy Policy</a>
      <a href="/terms" style="color:rgba(255,255,255,0.5);text-decoration:none;font-size:0.8rem;margin-right:1.5rem;">Terms of Service</a>
      <a href="/cookies" style="color:rgba(255,255,255,0.5);text-decoration:none;font-size:0.8rem;">Cookie Settings</a>
    </div>
    <p class="footer-text" style="margin-top:2rem;font-size:0.9rem;font-weight:600;color:var(--color-gold);">{t.footer.callToAction}</p>
    <p class="footer-text" style="margin-top:1rem;white-space:pre-line;">{t.footer.text}</p>
    <p class="footer-image-credits">
      <strong>{ec.imageCreditsTitle}:</strong> {ec.imageCredits}
    </p>
  </footer>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" style="display:none;">
    <button id="lightbox-close" class="lightbox-close" type="button">×</button>
    <button id="lightbox-prev" class="lightbox-prev" type="button">‹</button>
    <img id="lightbox-img" class="lightbox-img" src="" alt="" />
    <div id="lightbox-caption" class="lightbox-caption"></div>
    <button id="lightbox-next" class="lightbox-next" type="button">›</button>
  </div>
</BaseLayout>
