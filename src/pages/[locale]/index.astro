const H1 = h1For(locale);
const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : SITE.baseUrl;
const pageUrl = `${site}/${locale}`;
const MAPS_URL = ATTRACTION.mapsShareUrl;

