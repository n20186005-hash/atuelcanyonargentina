const navExtra = NAV_LABELS[locale];

// 图片 Alt 语义绑定
const imgAlt = {
  rockWall: `${ATTRACTION.fullName} - bare rock canyon walls in ${ATTRACTION.city}, ${ATTRACTION.country}`,
  reservoir: `${ATTRACTION.fullName} - turquoise reservoir in ${ATTRACTION.city}, ${ATTRACTION.state}, ${ATTRACTION.country}`,
  gallery: (i: number, categoryLabel: string) =>
    `${ATTRACTION.fullName} - ${categoryLabel} photo ${i + 1} in ${ATTRACTION.city}, ${ATTRACTION.country}`,
  map: `${ATTRACTION.fullName} location map in ${ATTRACTION.city}, ${ATTRACTION.state}, ${ATTRACTION.country}`,
};
const categoryLabels: Record<string, string> = Object.fromEntries(
  t.gallery.categories.map((c) => [c.key, c.label])
);
const GALLERY_PLAN = [
  { key: 'canyon', from: 0, to: 3 },
  { key: 'reservoir', from: 4, to: 7 },
  { key: 'rock', from: 8, to: 11 },
  { key: 'panorama', from: 12, to: 15 },
];
function categoryForIndex(i: number): string {
  const plan = GALLERY_PLAN.find((p) => i >= p.from && i <= p.to);
  return plan ? plan.key : 'canyon';
}

// 响应式图片派生信息（由 scripts/optimize-images.cjs 生成）
interface Rendition {
  base: string;
  width: number;
  height: number;
  aspect: number;
  widths: number[];
  jpg: Record<string, string>;
  webp: Record<string, string>;
  lqip: string;
}
const IMG = (imageManifestData as unknown as { images: Record<string, Rendition> }).images;
const heroBg = IMG['canon-del-atuel-16'];
const HERO_BG_WEBP = heroBg ? heroBg.webp[heroBg.widths[heroBg.widths.length - 1]] : undefined;

function toSrcset(map: Record<string, string>, widths: number[]): string {
  return widths.map((w) => `${map[w]} ${w}w`).join(', ');
}
function largest(map: Record<string, string>, widths: number[]): string {
  return map[widths[widths.length - 1]];
}

const galleryImages = (galleryImagesData as string[]).map((base, i) => ({
  base,
  category: categoryForIndex(i),
  img: IMG[base],
}));

/** 画廊缩略图显示尺寸提示 */
const GALLERY_SIZES = '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 260px';
/** 双栏对比图显示尺寸提示 */
const HALF_SIZES = '(max-width: 900px) 100vw, 50vw';

