---
import '../styles/globals.css';
import '../styles/additions.css';
import { localeConfig, hreflang, type Locale } from '../i18n/config';
import { getSeo } from '../lib/seo';
import { generateSchema } from '../lib/schema';
import { SITE, ATTRACTION } from '../lib/site-config';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  pathOverride?: string;
  /**
   * 子页面 slug。子页面在各语言下使用同一 slug，
   * 传入后 hreflang 会为每种语言生成指向「对应语言同一子页面」的地址，
   * 而不是全部指回各语言首页——后者会让多语言子页面互相失去关联。
   */
  slug?: string;
  /** 子页面可覆盖 OG / Twitter 标题与描述（缺省回退到首页 SEO） */
  ogTitle?: string;
  ogDescription?: string;
  /** 子页面自定义结构化数据；传入时不再输出首页的整套 Schema */
  schemaExtra?: Record<string, unknown> | null;
  includeSchema?: boolean;
  /** 首屏 LCP 图片（WebP）预加载 */
  preloadImage?: string;
}

const {
  locale,
  title,
  description,
  pathOverride,
  slug,
  ogTitle,
  ogDescription,
  schemaExtra,
  includeSchema = true,
  preloadImage,
} = Astro.props as Props;
const cfg = localeConfig[locale] || localeConfig.es;
const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://atuelcanyonargentina.com';
const suffix = slug ? `/${slug}` : '';
const canonical = pathOverride ? `${site}${pathOverride}` : `${site}/${locale}${suffix}`;
const alternates: Record<string, string> = {
  es: `${site}/es${suffix}`,
  en: `${site}/en${suffix}`,
  zh: `${site}/zh${suffix}`,
  it: `${site}/it${suffix}`,
};
const seo = getSeo(locale);
const ogImage = `${site}/og-image.jpg`;
const ogImageAlt = `${seo.ogImageAlt} — ${ATTRACTION.fullName} (${ATTRACTION.city})`;
const schema = includeSchema ? generateSchema(locale, site) : schemaExtra;
const metaOgTitle = ogTitle || seo.ogTitle;
const metaOgDescription = ogDescription || seo.ogDescription;
---

<!doctype html>
<html lang={cfg.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content={ATTRACTION.fullName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={ATTRACTION.fullName} />
    <meta name="msapplication-TileColor" content={SITE.themeColor} />
    <link rel="canonical" href={canonical} />
    {
      Object.entries(alternates).map(([l, url]) => (
        <link rel="alternate" hreflang={hreflang[l as Locale] ?? l} href={url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternates.es} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={cfg.ogLocale} />
    {
      Object.values(localeConfig)
        .filter((c) => c.ogLocale !== cfg.ogLocale)
        .map((c) => <meta property="og:alternate_locale" content={c.ogLocale} />)
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={metaOgTitle} />
    <meta property="og:description" content={metaOgDescription} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaOgTitle} />
    <meta name="twitter:description" content={metaOgDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212" />

    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    {/* 在绘制前设置主题，避免闪烁 */}
    <script
      is:inline
      set:html={`(function(){try{var t=localStorage.getItem('theme');if(t!=='light'&&t!=='dark'){t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','light');}})();`}
    ></script>

    {
      schema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>
      )
    }

    {/* Google Analytics 4 */}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
    <script
      is:inline
      set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${SITE.ga4Id}');`}
    ></script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/site';
    </script>
    {/* PWA Service Worker 注册 */}
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
